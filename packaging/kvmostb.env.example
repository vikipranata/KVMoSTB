# KVMoSTB credentials (form login, session cookie for the web console + API).
# Both values are REQUIRED: if either is empty the API fails closed and
# refuses every request except /healthz.
ADMIN_USER=
ADMIN_PASSWORD=

# Optional network binding (defaults: all interfaces, port 8080).
#LISTEN_ADDRESS=0.0.0.0
#LISTEN_PORT=8080

# Optional: mount the newest ISO at boot (default: off, mount via UI).
#ISO_AUTO_MOUNT=false
# Optional: local ISO directory (NFS /mnt/shared/iso stays primary).
#ISO_LOCATION_DIR=/var/lib/kvmostb/iso

# Optional log level: debug, info, warn, error (default: info).
#LOG_LEVEL=debug
