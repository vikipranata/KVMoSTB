[Unit]
Description=KVMoSTB USB HID gadget (configfs bring-up)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
# The first attempt can fail with EBUSY while stale configfs state still holds
# a UDC that cannot unbind, so retry for up to 10 seconds.
ExecStart=/bin/sh -c "for i in 1 2 3 4 5; do /usr/bin/kvmostb -gadget-init && break; sleep 2; done"

[Install]
WantedBy=multi-user.target
